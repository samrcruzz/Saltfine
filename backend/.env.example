PORT=5000
PGUSER=postgres
PGHOST=localhost
PGDATABASE=saltfine_db
PGPASSWORD=postgres
PGPORT=5432

# Start with simulated demo records (default: empty, real photos + model only)
SEED_DEMO_DATA=false
# Folder the camera saves photos to; "Trigger cycle" analyzes the oldest one
CAMERA_INBOX=camera_inbox

# Signs the sign-in session cookie. Use a long random value (at least 32 characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, everyone is signed out whenever the server restarts.
AUTH_SECRET=
